{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter: bkhidmatk",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "toolArgs": [
                "--no-pub",
                "--dart-define=DEV_ADMIN_PREVIEW=true"
            ]
        },
        {
            "name": "Flutter: Supabase (OTP)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "toolArgs": [
                "--no-pub",
                "--dart-define=SUPABASE_URL=${env:SUPABASE_URL}",
                "--dart-define=SUPABASE_PUBLISHABLE_KEY=${env:SUPABASE_PUBLISHABLE_KEY}"
            ]
        }
    ]
}