{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Flutter: Supabase (كلمة المرور)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "preLaunchTask": "Prepare Supabase run",
            "toolArgs": [
                "--no-pub",
                "--dart-define=DEV_ADMIN_PREVIEW=false",
                "--dart-define-from-file=.dart-defines.json"
            ]
        },
        {
            "name": "Flutter: Local preview (بدون قاعدة بيانات)",
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "debug",
            "preLaunchTask": "Stop earlier Flutter runs",
            "toolArgs": [
                "--no-pub",
                "--dart-define=DEV_ADMIN_PREVIEW=true"
            ]
        },
        {
            "name": "Flutter: تجربة السلاسة مع Supabase (Release، بدون Inspector)",
            "presentation": {
                "hidden": true
            },
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "release",
            "preLaunchTask": "Prepare Supabase run",
            "toolArgs": [
                "--no-pub",
                "--dart-define=DEV_ADMIN_PREVIEW=false",
                "--dart-define-from-file=.dart-defines.json"
            ]
        },
        {
            "name": "Flutter: تجربة السلاسة محلياً (Release، بدون Inspector)",
            "presentation": {
                "hidden": true
            },
            "type": "dart",
            "request": "launch",
            "program": "lib/main.dart",
            "cwd": "${workspaceFolder}",
            "flutterMode": "release",
            "preLaunchTask": "Stop earlier Flutter runs",
            "toolArgs": [
                "--no-pub",
                "--dart-define=DEV_ADMIN_PREVIEW=true"
            ]
        }
    ]
}
